5530:4;15499:36;:::i;:::-;15557:1;15571:208;15585:7;15582:1;15579:14;15571:208;;;15664:9;15659:3;15655:19;15649:26;15641:6;15634:42;15715:1;15707:6;15703:14;15693:24;;15762:2;15751:9;15747:18;15734:31;;15608:4;15605:1;15601:12;15596:17;;15571:208;;;15807:6;15798:7;15795:19;15792:179;;;15865:9;15860:3;15856:19;15850:26;15908:48;15950:4;15942:6;15938:17;15927:9;15908:48;:::i;:::-;15900:6;15893:64;15815:156;15792:179;16017:1;16013;16005:6;16001:14;15997:22;15991:4;15984:36;15420:610;;;15383:886;;14974:1301;;;14883:1392;;:::o","linkReferences":{}},"methodIdentifiers":{"burn(address,uint256)":"9dc29fac","deliver(address,bytes)":"69783d77","length(address)":"2c566ae5","read(address,uint256)":"014c2add"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.36+commit.8a079791\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"from\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"uint256\",\"name\":\"seq\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"bytes32\",\"name\":\"cid\",\"type\":\"bytes32\"}],\"name\":\"Inbox\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"seq\",\"type\":\"uint256\"}],\"name\":\"burn\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"bytes\",\"name\":\"data\",\"type\":\"bytes\"}],\"name\":\"deliver\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"}],\"name\":\"length\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"seq\",\"type\":\"uint256\"}],\"name\":\"read\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"from\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"blockNumber\",\"type\":\"uint256\"},{\"internalType\":\"bytes\",\"name\":\"data\",\"type\":\"bytes\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"The mailbox NEVER holds a key. The blob is mycelium's E2E envelope      (eph_pub || nonce || ciphertext) produced by internal/secure \\u2014 the      contract only stores and re-emits opaque bytes. Privacy comes from m\\u00b3      crypto, not from this contract.\",\"kind\":\"dev\",\"methods\":{\"deliver(address,bytes)\":{\"params\":{\"data\":\"mycelium E2E envelope (kind || eph_pub || nonce || ciphertext)\",\"to\":\"recipient address\"}}},\"title\":\"MyceliumMailbox\",\"version\":1},\"userdoc\":{\"events\":{\"Inbox(address,address,uint256,bytes32)\":{\"notice\":\"Emitted when a message is delivered to a recipient. Recipients poll Inbox(to=us) via eth_getLogs \\u2014 cheap, no full block scan.\"}},\"kind\":\"user\",\"methods\":{\"burn(address,uint256)\":{\"notice\":\"Burn a message (compost semantics: content should rot). Sets the stored data to empty so it no longer exists. Only recipient.\"},\"deliver(address,bytes)\":{\"notice\":\"Store an E2E-encrypted envelope for `to`. Reverts if the envelope is empty (no point storing nothing). Emits Inbox.\"},\"length(address)\":{\"notice\":\"Total messages stored for a recipient (to know seq range to poll).\"},\"read(address,uint256)\":{\"notice\":\"Read a specific message. Only the recipient (or anyone \\u2014 data is already E2E-encrypted, so reading is not a privacy leak; but we restrict to recipient for cleanliness) may read.\"}},\"notice\":\"Scalable inbox for mycelium on EVM chains. Instead of scanning every         block for txs addressed to a recipient (slow on busy chains), a         recipient registers here and mycelium messages are stored as opaque         E2E-encrypted blobs, addressed by recipient, with a log event the         recipient's indexer polls via eth_getLogs.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/MyceliumMailbox.sol\":\"MyceliumMailbox\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":false,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/MyceliumMailbox.sol\":{\"keccak256\":\"0x7c325a2596359810714ce03c9e02ef60bf5509365734fd16b45a9b4ce3a0ec4e\",\"license\":\"BSD-3-Clause\",\"urls\":[\"bzz-raw://da2a5ab721b198a3be27f583987413e6ec92ccaccdc1084419e2ed1fe9fdc0e0\",\"dweb:/ipfs/QmTdHkb5jeg1BKmFnCnLDVvJjwpEgHzD8K7zf92LqHbRsf\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.36+commit.8a079791"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"address","name":"to","type":"address","indexed":true},{"internalType":"address","name":"from","type":"address","indexed":true},{"internalType":"uint256","name":"seq","type":"uint256","indexed":true},{"internalType":"bytes32","name":"cid","type":"bytes32","indexed":false}],"type":"event","name":"Inbox","anonymous":false},{"inputs":[{"internalType":"address","name":"to","type":"address"},{"internalType":"uint256","name":"seq","type":"uint256"}],"stateMutability":"nonpayable","type":"function","name":"burn"},{"inputs":[{"internalType":"address","name":"to","type":"address"},{"internalType":"bytes","name":"data","type":"bytes"}],"stateMutability":"nonpayable","type":"function","name":"deliver","outputs":[{"internalType":"uint256","name":"","type":"uint256"}]},{"inputs":[{"internalType":"address","name":"to","type":"address"}],"stateMutability":"view","type":"function","name":"length","outputs":[{"internalType":"uint256","name":"","type":"uint256"}]},{"inputs":[{"internalType":"address","name":"to","type":"address"},{"internalType":"uint256","name":"seq","type":"uint256"}],"stateMutability":"view","type":"function","name":"read","outputs":[{"internalType":"address","name":"from","type":"address"},{"internalType":"uint256","name":"blockNumber","type":"uint256"},{"internalType":"bytes","name":"data","type":"bytes"}]}],"devdoc":{"kind":"dev","methods":{"deliver(address,bytes)":{"params":{"data":"mycelium E2E envelope (kind || eph_pub || nonce || ciphertext)","to":"recipient address"}}},"version":1},"userdoc":{"kind":"user","methods":{"burn(address,uint256)":{"notice":"Burn a message (compost semantics: content should rot). Sets the stored data to empty so it no longer exists. Only recipient."},"deliver(address,bytes)":{"notice":"Store an E2E-encrypted envelope for `to`. Reverts if the envelope is empty (no point storing nothing). Emits Inbox."},"length(address)":{"notice":"Total messages stored for a recipient (to know seq range to poll)."},"read(address,uint256)":{"notice":"Read a specific message. Only the recipient (or anyone — data is already E2E-encrypted, so reading is not a privacy leak; but we restrict to recipient for cleanliness) may read."}},"version":1}},"settings":{"remappings":[],"optimizer":{"enabled":false,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"contracts/MyceliumMailbox.sol":"MyceliumMailbox"},"evmVersion":"osaka","libraries":{}},"sources":{"contracts/MyceliumMailbox.sol":{"keccak256":"0x7c325a2596359810714ce03c9e02ef60bf5509365734fd16b45a9b4ce3a0ec4e","urls":["bzz-raw://da2a5ab721b198a3be27f583987413e6ec92ccaccdc1084419e2ed1fe9fdc0e0","dweb:/ipfs/QmTdHkb5jeg1BKmFnCnLDVvJjwpEgHzD8K7zf92LqHbRsf"],"license":"BSD-3-Clause"}},"version":1},"id":0}